# ========================================
# SUPABASE DATABASE CONFIGURATION
# ========================================
# Remplacez les valeurs ci-dessous par vos vraies credentials Supabase

# Connection pooler (Recommandé pour production)
DATABASE_URL="postgresql://postgres.XXXXX:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# OU Connection directe (Pour développement)
# DATABASE_URL="postgresql://postgres.XXXXX:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ========================================
# APPLICATION CONFIGURATION
# ========================================
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5174
FRONTEND_URL=http://localhost:5174

# ========================================
# FIREBASE (Push Notifications)
# ========================================
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"votre-projet","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
","client_email":"firebase-adminsdk-xxxxx@votre-projet.iam.gserviceaccount.com","client_id":"..."}

# ========================================
# INSTRUCTIONS
# ========================================
# 1. Allez sur https://app.supabase.com
# 2. Sélectionnez votre projet
# 3. Settings → Database → Connection string
# 4. Copiez la URI et remplacez DATABASE_URL ci-dessus
# 5. N'oubliez pas de remplacer [YOUR-PASSWORD] par votre vrai mot de passe!
